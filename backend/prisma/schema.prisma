datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  icon        String   @db.VarChar(50)
  description String?  @db.Text
  talents     Talent[]

  @@map("categories")
}

model Talent {
  id              String    @id @db.VarChar(64)
  name            String    @db.VarChar(255)
  handle          String    @unique @db.VarChar(100)
  title           String    @db.VarChar(255)
  category_id     Int?
  category        Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  bio             String    @db.Text
  avatar_url      String    @db.Text
  hero_video_url  String    @db.Text
  sample_videos   Json?     @default("[]")
  rating          Decimal?  @default(5.0) @db.Decimal(3, 2)
  review_count    Int?      @default(0)
  response_time   String?   @default("⚡ Within 24 hours") @db.VarChar(50)
  price_video     Int
  price_live_call Int
  etb_rate        Int?      @default(120)
  verified        Boolean?  @default(true)
  featured        Boolean?  @default(false)
  trending        Boolean?  @default(false)
  languages       String[]  @default(["Amharic", "English"])
  tags            String[]  @default([])
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  bookings        Booking[]
  reviews         Review[]

  @@map("talents")
}

model Occasion {
  id   String @id @db.VarChar(50)
  name String @db.VarChar(100)
  icon String @db.VarChar(50)

  @@map("occasions")
}

model Booking {
  id                  String    @id @db.VarChar(64)
  talent_id           String?   @db.VarChar(64)
  talent              Talent?   @relation(fields: [talent_id], references: [id], onDelete: Cascade)
  customer_name       String    @db.VarChar(255)
  customer_email      String    @db.VarChar(255)
  recipient_name      String    @db.VarChar(255)
  booking_type        String    @db.VarChar(50)
  occasion            String    @db.VarChar(100)
  instructions        String    @db.Text
  delivery_speed      String?   @default("standard") @db.VarChar(50)
  status              String?   @default("pending") @db.VarChar(50)
  total_price         Int
  currency            String?   @default("USD") @db.VarChar(10)
  scheduled_date      String?   @db.VarChar(100)
  completed_video_url String?   @db.Text
  talent_message      String?   @db.Text
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  reviews             Review[]

  @@map("bookings")
}

model Review {
  id                 String    @id @db.VarChar(64)
  talent_id          String    @db.VarChar(64)
  talent             Talent    @relation(fields: [talent_id], references: [id], onDelete: Cascade)
  booking_id         String?   @db.VarChar(64)
  booking            Booking?  @relation(fields: [booking_id], references: [id], onDelete: SetNull)
  customer_name      String    @db.VarChar(255)
  rating             Int
  comment            String    @db.Text
  occasion           String?   @db.VarChar(100)
  video_response_url String?   @db.Text
  created_at         DateTime? @default(now()) @db.Timestamptz(6)

  @@map("reviews")
}
